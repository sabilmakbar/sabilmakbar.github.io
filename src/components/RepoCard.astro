---
const { repo } = Astro.props;
---
<li>
  <article class="group relative flex h-full flex-col rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent focus-within:border-accent">
    <a
      href={repo.url}
      target="_blank"
      rel="noopener"
      aria-label={`View ${repo.owner}/${repo.name} on GitHub`}
      class="absolute inset-0 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    ></a>
    <div class="pointer-events-none relative flex items-start justify-between gap-3">
      <span class="min-w-0 break-words font-display font-semibold text-fg transition-colors group-hover:text-accent">{repo.name}</span>
      {repo.stars >= 0 && (
        <span class="flex shrink-0 items-center gap-1 font-mono text-xs text-muted">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
          {repo.stars}
        </span>
      )}
    </div>
    <p class="pointer-events-none relative mt-1 font-mono text-xs text-muted">{repo.owner}</p>
    <p class="pointer-events-none relative mt-3 flex-1 text-sm text-fg/90">{repo.desc}</p>
    <div class="pointer-events-none relative mt-4 flex flex-wrap items-center justify-between gap-2">
      <span class="font-mono text-xs text-accent">{repo.lang}</span>
      <div class="flex items-center gap-3 text-sm">
        <a href={`/projects/${repo.slug}/`} class="pointer-events-auto relative z-10 inline-flex min-h-11 items-center font-medium text-accent hover:underline">
          Read README
        </a>
        <span class="inline-flex min-h-11 items-center text-muted transition-colors group-hover:text-accent">View on GitHub ↗</span>
      </div>
    </div>
  </article>
</li>

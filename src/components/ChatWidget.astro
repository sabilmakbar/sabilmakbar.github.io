---
// Floating chat widget -> shared QA client (src/lib/qa.ts).
// Wrapped in a transition:persist container so an open chat and its history
// survive page navigation (paired with <ClientRouter /> in Base.astro).
---

<div id="pqa-root" transition:persist="chat-widget">
  <button
    id="pqa-fab"
    aria-label="Ask about Sabil"
    class="pqa-fab fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-accent px-5 py-3.5 text-accent-fg shadow-xl ring-4 ring-accent/20 transition-transform hover:scale-105"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span class="font-display text-sm font-semibold">Ask about me</span>
  </button>

  <div
    id="pqa-panel"
    role="dialog"
    aria-label="Ask about Sabil"
    class="fixed bottom-24 right-5 z-50 hidden w-[min(380px,calc(100vw-2.5rem))] flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-2xl"
    style="height:min(520px,calc(100vh-9rem))"
  >
    <div class="flex items-center justify-between bg-accent px-4 py-3 text-accent-fg">
      <span class="font-display font-semibold">Ask about Sabil</span>
      <button id="pqa-close" aria-label="Close" class="text-xl leading-none opacity-80 hover:opacity-100">×</button>
    </div>
    <div id="pqa-msgs" class="flex-1 space-y-3 overflow-y-auto p-4 text-sm">
      <div class="pqa-bot"><span class="inline-block rounded-xl bg-bg px-3 py-2">Hi! Ask me anything about Sabil's background, work, or research.</span></div>
    </div>
    <div class="px-4 pb-2 text-xs text-muted">Answers are generated from this site's profile content.</div>
    <form id="pqa-form" autocomplete="off" class="flex border-t border-border">
      <input id="pqa-input" type="text" maxlength="500" placeholder="e.g. What does he work on?"
        class="flex-1 bg-transparent px-4 py-3 text-sm text-fg outline-none placeholder:text-muted" />
      <button id="pqa-send" type="submit" class="bg-accent px-4 text-sm font-medium text-accent-fg disabled:opacity-50">Send</button>
    </form>
  </div>
</div>

<style>
  /* gentle attention pulse a few times on load */
  @keyframes pqa-attn {
    0%, 100% { box-shadow: 0 10px 25px rgb(0 0 0 / 0.15), 0 0 0 0 var(--accent); }
    50% { box-shadow: 0 10px 25px rgb(0 0 0 / 0.15), 0 0 0 10px transparent; }
  }
  .pqa-fab { animation: pqa-attn 2s ease-out 3; }
  @media (prefers-reduced-motion: reduce) { .pqa-fab { animation: none; } }
</style>

<script>
  import { askProfileQA, loadTranscript, saveTranscript, errorMessage, type Turn } from "../lib/qa";

  function init() {
    const root = document.getElementById("pqa-root");
    if (!root || root.dataset.bound) return; // persisted node: bind once
    root.dataset.bound = "1";

    const fab = document.getElementById("pqa-fab") as HTMLButtonElement;
    const panel = document.getElementById("pqa-panel") as HTMLElement;
    const msgs = document.getElementById("pqa-msgs") as HTMLElement;
    const form = document.getElementById("pqa-form") as HTMLFormElement;
    const input = document.getElementById("pqa-input") as HTMLInputElement;
    const send = document.getElementById("pqa-send") as HTMLButtonElement;

    const toggle = (open: boolean) => {
      panel.classList.toggle("hidden", !open);
      panel.classList.toggle("flex", open);
      if (open) input.focus();
    };
    fab.addEventListener("click", () => toggle(panel.classList.contains("hidden")));
    document.getElementById("pqa-close")!.addEventListener("click", () => toggle(false));

    function addMsg(text: string, who: "user" | "bot") {
      const wrap = document.createElement("div");
      wrap.className = who === "user" ? "text-right" : "";
      const b = document.createElement("span");
      b.className =
        who === "user"
          ? "inline-block rounded-xl bg-accent px-3 py-2 text-accent-fg text-left max-w-[90%]"
          : "inline-block rounded-xl bg-bg px-3 py-2 text-left max-w-[90%] whitespace-pre-wrap";
      b.textContent = text;
      wrap.appendChild(b);
      msgs.appendChild(wrap);
      msgs.scrollTop = msgs.scrollHeight;
      return b;
    }

    // rehydrate any prior conversation (from this or the landing page)
    const turns: Turn[] = loadTranscript();
    for (const t of turns) {
      addMsg(t.q, "user");
      addMsg(t.a, "bot");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      addMsg(q, "user");
      input.value = "";
      send.disabled = true;
      const thinking = addMsg("…", "bot");
      const wake = setTimeout(() => { thinking.textContent = "Thinking…"; }, 3000);

      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 60000);
      try {
        const answer = await askProfileQA(q, controller.signal);
        thinking.textContent = answer;
        turns.push({ q, a: answer });
        saveTranscript(turns);
      } catch (err) {
        thinking.textContent = errorMessage(err);
      } finally {
        clearTimeout(wake);
        clearTimeout(timeout);
        send.disabled = false;
        msgs.scrollTop = msgs.scrollHeight;
      }
    });
  }

  document.addEventListener("astro:page-load", init);
</script>

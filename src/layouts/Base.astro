---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { profile, nav } from "../data/profile";
import ChatWidget from "../components/ChatWidget.astro";

// Optional privacy-friendly analytics (Cloudflare Web Analytics), same convention
// as the relo-calculator: set CF_ANALYTICS_TOKEN in the build environment to
// enable; unset means no script is emitted and no third-party request is made.
const cfAnalyticsToken = (process.env.CF_ANALYTICS_TOKEN ?? "").trim();

const { title, description, hideChat = false, hideFooter = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.short}` : `${profile.name} · ${profile.tagline}`;
const desc = description ?? profile.blurb;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />


    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    <!-- set theme before paint, and re-apply after each view-transition swap -->
    <script is:inline>
      (function () {
        const apply = () => {
          const t = localStorage.getItem("theme");
          const dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur">
      <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
        <a href="/" class="group flex flex-col leading-none">
          <span class="font-display font-bold tracking-tight text-fg group-hover:text-accent transition-colors">
            {profile.brand}
          </span>
          <span class="mt-1 block text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">
            {profile.brandTag}
          </span>
        </a>
        <div class="flex items-center gap-2">
          <div class="hidden items-center gap-1 lg:flex">
            {nav.map((item) => {
              const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  class:list={[
                    "rounded-md px-2.5 py-1.5 text-sm transition-colors hover:text-accent",
                    active ? "text-accent font-medium" : "text-muted",
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
          <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="rounded-md border border-border p-2.5 text-muted hover:text-accent hover:border-accent transition-colors"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.72 0l-.7.7M6.34 17.66l-.7.7"/><circle cx="12" cy="12" r="4"/></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <button
            id="nav-toggle"
            aria-label="Toggle menu"
            aria-expanded="false"
            class="rounded-md border border-border p-2.5 text-muted transition-colors hover:border-accent hover:text-accent lg:hidden"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </nav>

      <!-- mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-border lg:hidden">
        <div class="mx-auto flex max-w-4xl flex-col px-4 py-2">
          {nav.map((item) => {
            const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-3 py-2.5 text-sm transition-colors hover:bg-surface",
                  active ? "text-accent font-medium" : "text-fg",
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-12 sm:py-16">
      <slot />
    </main>

    {!hideFooter && (
      <footer class="border-t border-border">
        <div class="mx-auto flex max-w-4xl flex-col gap-2 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
          <span>© {new Date().getFullYear()} {profile.name}</span>
          <a href={`mailto:${profile.email}`} class="transition-colors hover:text-accent">Contact me by Email</a>
        </div>
      </footer>
    )}

    {!hideChat && <ChatWidget />}

    {cfAnalyticsToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}

    <script>
      // Header controls are re-rendered on each view-transition navigation, so
      // (re)bind them on every astro:page-load rather than once.
      function setupChrome() {
        document.getElementById("theme-toggle")?.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", dark ? "dark" : "light");
        });
        const navToggle = document.getElementById("nav-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        navToggle?.addEventListener("click", () => {
          const open = mobileMenu!.classList.toggle("hidden") === false;
          navToggle.setAttribute("aria-expanded", String(open));
        });
        // close the menu after tapping a link
        mobileMenu?.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => mobileMenu.classList.add("hidden")),
        );
      }
      document.addEventListener("astro:page-load", setupChrome);
    </script>
  </body>
</html>

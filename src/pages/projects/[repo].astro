---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { getReadmeHtml, getRepositories, type Repository } from "../../lib/github";

export const getStaticPaths = (async () => {
  const { featured, personal } = await getRepositories();
  const repositories = [...featured, ...personal];
  return repositories.map((repo) => ({ params: { repo: repo.slug }, props: { repo } }));
}) satisfies GetStaticPaths;

const { repo } = Astro.props as { repo: Repository };
const readme = await getReadmeHtml(repo);
const fullDescription = repo.desc || `Project overview for ${repo.owner}/${repo.name}.`;
const description = fullDescription.length > 125 ? `${fullDescription.slice(0, 122).trimEnd()}...` : fullDescription;
---

<Base title={repo.name} description={description}>
  <header class="mb-10">
    <a href="/repositories/" class="text-sm text-muted hover:text-accent">← All repositories</a>
    <p class="eyebrow mb-2 mt-6">{repo.owner}</p>
    <h1 class="break-words text-3xl font-bold sm:text-4xl">{repo.name}</h1>
    {repo.desc && <p class="mt-3 max-w-2xl text-muted">{repo.desc}</p>}
    <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
      {repo.lang && <span class="rounded-full border border-border px-3 py-1 font-mono text-accent">{repo.lang}</span>}
      {repo.stars >= 0 && <span class="text-muted">★ {repo.stars}</span>}
      <a href={repo.url} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">
        View on GitHub →
      </a>
    </div>
  </header>

  {readme ? (
    <article class="prose project-readme" set:html={readme} />
  ) : (
    <section class="rounded-xl border border-border bg-surface p-6">
      <p class="text-muted">The README could not be loaded during this build.</p>
      <a href={repo.url} target="_blank" rel="noopener" class="mt-3 inline-block text-accent hover:underline">
        Read it on GitHub →
      </a>
    </section>
  )}
</Base>

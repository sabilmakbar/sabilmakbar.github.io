---
import Base from "../layouts/Base.astro";
import { publications } from "../data/publications";
import { awards } from "../data/cv";
import { scholar } from "../data/profile";

const byYear = [...publications].sort((a, b) => b.year - a.year);
const hi = (a: string) => a.replace(/(Salsabil[^,]*|Akbar)/, "<b class='text-fg'>$1</b>");
---

<Base title="Papers & Awards" description="Research papers and awards of Salsabil Maulana Akbar.">
  <header class="mb-10">
    <p class="eyebrow mb-2">Research & recognition</p>
    <h1 class="text-3xl font-bold sm:text-4xl">Papers & Awards</h1>
    <p class="mt-3 text-muted">Peer-reviewed and preprint work.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {scholar.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          class="rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
        >
          {s.label} →
        </a>
      ))}
    </div>
  </header>

  <h2 class="eyebrow mb-5">Publications</h2>
  <ol class="divide-y divide-border">
    {byYear.map((p) => (
      <li class="py-6">
        <div class="flex items-start gap-4">
          <span class="mt-1 font-mono text-sm text-accent">{p.year}</span>
          <div class="min-w-0">
            <h2 class="font-display font-semibold leading-snug">
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener" class="hover:text-accent transition-colors">{p.title}</a>
              ) : (
                p.title
              )}
            </h2>
            <p class="mt-1 text-sm text-muted" set:html={hi(p.authors)} />
            {p.venue && <p class="mt-1 text-sm"><span class="text-accent">{p.venue}</span></p>}
          </div>
        </div>
      </li>
    ))}
  </ol>

  <section class="mt-14">
    <h2 class="eyebrow mb-5">Awards</h2>
    <ul class="divide-y divide-border">
      {awards.map((a) => (
        <li class="py-4">
          <div class="flex items-start gap-4">
            <span class="mt-0.5 shrink-0 font-mono text-sm text-accent">{a.year}</span>
            <div class="min-w-0">
              <h3 class="font-display font-semibold leading-snug">{a.title}</h3>
              <p class="mt-1 text-sm text-muted">{a.org}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

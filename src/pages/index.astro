---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
import { publications } from "../data/publications";

const focus = [
  "Search relevance, ranking & retrieval",
  "NLP for product discovery & query understanding",
  "Indonesian & low-resource-language NLP",
];
const selected = publications.filter((p) => p.selected);
---

<Base>
  {/* hero */}
  <section class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <p class="eyebrow mb-3">{profile.location}</p>
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl">{profile.name}</h1>
      <p class="mt-3 text-lg text-muted">{profile.tagline}</p>
      <p class="mt-5 leading-relaxed text-fg/90">{profile.blurb}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {profile.social.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener"
            class="rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>
    <img
      src={profile.avatar}
      alt={profile.name}
      width="160"
      height="160"
      class="h-32 w-32 shrink-0 rounded-2xl border border-border object-cover sm:h-40 sm:w-40"
    />
  </section>

  {/* focus */}
  <section class="mt-16">
    <h2 class="eyebrow mb-4">Currently focused on</h2>
    <ul class="space-y-2">
      {focus.map((f) => (
        <li class="flex gap-3 text-fg/90">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
          {f}
        </li>
      ))}
    </ul>
  </section>

  {/* selected publications */}
  <section class="mt-16">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="eyebrow">Selected publications</h2>
      <a href="/publications/" class="text-sm text-muted hover:text-accent transition-colors">All publications →</a>
    </div>
    <ul class="divide-y divide-border">
      {selected.map((p) => (
        <li class="py-4">
          <a href={p.url} target="_blank" rel="noopener" class="group block">
            <h3 class="font-display font-semibold leading-snug text-fg group-hover:text-accent transition-colors">{p.title}</h3>
            <p class="mt-1 text-sm text-muted">
              {p.venue && <span class="text-accent">{p.venue} {p.year}</span>}
              {p.venue ? " · " : ""}<span set:html={p.authors.replace(/(Salsabil[^,]*|Akbar)/, "<b class='text-fg'>$1</b>")} />
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* quick links */}
  <section class="mt-16 grid gap-3 sm:grid-cols-3">
    {[
      { href: "/repositories/", label: "Repositories", desc: "Open-source & code" },
      { href: "/cv/", label: "Resume", desc: "Education & experience" },
      { href: "/teaching/", label: "Teaching", desc: "Assistantship" },
    ].map((c) => (
      <a href={c.href} class="rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent">
        <div class="font-display font-semibold text-fg">{c.label}</div>
        <div class="mt-1 text-sm text-muted">{c.desc}</div>
      </a>
    ))}
  </section>
</Base>

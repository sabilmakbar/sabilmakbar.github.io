---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base hideChat hideFooter>
  <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center text-center">
    <div id="hero-avatar" class="relative mb-6 h-20 w-20">
      <img
        src={profile.avatar}
        alt={profile.name}
        width="88"
        height="88"
        class="avatar-face absolute inset-0 h-full w-full rounded-2xl border border-border object-cover transition-opacity duration-1000 ease-in-out"
        style="opacity:1"
      />
      <img
        src={profile.avatarAlt}
        alt={profile.name}
        width="88"
        height="88"
        class="avatar-face absolute inset-0 h-full w-full rounded-2xl border border-border object-cover transition-opacity duration-1000 ease-in-out"
        style="opacity:0"
      />
    </div>
    <p class="eyebrow mb-2">Welcome</p>
    <h1 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
      {profile.name}
    </h1>
    <p class="mt-3 text-muted">{profile.tagline}</p>

    <form id="ask-form" autocomplete="off" class="mt-8 w-full">
      <div class="flex items-center gap-2 rounded-full border border-border bg-surface px-5 py-3 shadow-lg transition-colors focus-within:border-accent">
        <svg class="h-5 w-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        <div class="relative min-w-0 flex-1">
          <input
            id="ask-input"
            type="text"
            maxlength="500"
            placeholder="Ask me anything about Sabil..."
            data-suggestions={JSON.stringify([
              "Ask me anything about Sabil...",
              "How many years of experience does he have?",
              "What did he build for search at Tokopedia?",
              "What is he working on right now?",
              "Which papers has he co-authored?",
              "What is he exploring next?",
            ])}
            class="w-full bg-transparent text-base text-fg outline-none placeholder:text-muted"
          />
          {/* animated stand-in for the placeholder; JS clears the native one */}
          <span
            id="ask-hint"
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 hidden items-center truncate text-base text-muted opacity-0 transition-opacity duration-700 ease-in-out"
          ></span>
        </div>
      </div>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <button
          id="ask-send"
          type="submit"
          class="rounded-full bg-accent px-6 py-2.5 text-sm font-semibold text-accent-fg transition-transform hover:scale-105 disabled:opacity-50 disabled:hover:scale-100"
        >
          Ask
        </button>
        <a
          href="/about/"
          class="rounded-full border border-border px-6 py-2.5 text-sm font-medium text-muted transition-colors hover:border-accent hover:text-accent"
        >
          Take me to the site →
        </a>
      </div>
      <p class="mt-3 text-xs text-muted">
        One question at a time here. For a back and forth, continue in the chat.
      </p>
    </form>

    <div id="ask-results" class="mt-10 w-full space-y-5 text-left"></div>
  </section>
</Base>

<script>
  import { askProfileQA, loadTranscript, saveTranscript, errorMessage, type Turn } from "../lib/qa";
  import { initAvatar } from "../lib/avatar";

  function init() {
    const form = document.getElementById("ask-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return; // idempotent under view transitions
    form.dataset.bound = "1";

    const input = document.getElementById("ask-input") as HTMLInputElement;
    const send = document.getElementById("ask-send") as HTMLButtonElement;
    const results = document.getElementById("ask-results") as HTMLElement;

    const turns: Turn[] = loadTranscript();

    // The landing answers one question at a time; a conversation belongs in the
    // chat widget, so each ask replaces the previous answer rather than stacking.
    function card(q: string, a: string) {
      results.replaceChildren();
      const wrap = document.createElement("div");
      wrap.className = "rounded-2xl border border-border bg-surface p-5";
      const qEl = document.createElement("p");
      qEl.className = "font-display font-semibold text-fg";
      qEl.textContent = q;
      const aEl = document.createElement("p");
      aEl.className = "mt-2 whitespace-pre-wrap break-words leading-relaxed text-fg/90";
      aEl.textContent = a;
      wrap.append(qEl, aEl);
      results.append(wrap);
      return aEl;
    }

    // once answered, offer to carry the thread into the chat widget
    function offerChat() {
      if (document.getElementById("ask-continue")) return;
      const a = document.createElement("a");
      a.id = "ask-continue";
      a.href = "/about/?chat=1";
      a.className =
        "mt-4 inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent";
      a.textContent = "Continue in chat →";
      results.append(a);
    }

    // Cycle example questions so visitors see what they can ask. The native
    // placeholder cannot be animated, so an overlay span is faded instead; the
    // native one stays as the no-JS fallback until this takes over.
    const hint = document.getElementById("ask-hint") as HTMLElement;
    let suggestions: string[] = [];
    try {
      suggestions = JSON.parse(input.dataset.suggestions || "[]");
    } catch {
      suggestions = [];
    }

    if (hint && suggestions.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const FADE = 700; // must match the span's duration-700

      // Hand off to the overlay for good. The native placeholder is never
      // restored, otherwise both would render at once.
      input.placeholder = "";
      hint.textContent = suggestions[0];
      hint.classList.replace("hidden", "flex");
      requestAnimationFrame(() => (hint.style.opacity = "1"));

      const idle = () => document.activeElement !== input && !input.value;

      let i = 0;
      setInterval(() => {
        if (!idle()) return;
        hint.style.opacity = "0";
        setTimeout(() => {
          if (!idle()) return;
          i = (i + 1) % suggestions.length;
          hint.textContent = suggestions[i];
          hint.style.opacity = "1";
        }, FADE);
      }, 4200); // fade out + hold + fade in

      // hide while typing or focused, bring back the opening line when idle
      input.addEventListener("focus", () => (hint.style.opacity = "0"));
      input.addEventListener("input", () => (hint.style.opacity = "0"));
      input.addEventListener("blur", () => {
        if (!input.value) {
          i = 0;
          hint.textContent = suggestions[0];
          hint.style.opacity = "1";
        }
      });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      // the question stays in the box so it can be tweaked and asked again
      send.disabled = true;
      hint.style.opacity = "0";
      const aEl = card(q, "");
      aEl.innerHTML = '<span class="typing"><i></i><i></i><i></i></span>';
      const wake = setTimeout(() => {
        aEl.innerHTML = '<span class="typing"><i></i><i></i><i></i></span> <span class="text-muted">still working…</span>';
      }, 8000);

      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 45000);
      try {
        // no history sent: the landing is one-off. The turn is still stored so
        // the chat widget can pick the thread up if the visitor continues there.
        const answer = await askProfileQA(q, controller.signal, []);
        aEl.textContent = answer;
        turns.push({ q, a: answer });
        saveTranscript(turns);
        offerChat();
      } catch (err) {
        aEl.textContent = errorMessage(err);
      } finally {
        clearTimeout(wake);
        clearTimeout(timeout);
        send.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:page-load", initAvatar);
</script>

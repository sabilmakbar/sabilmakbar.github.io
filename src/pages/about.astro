---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { profile, scholar } from "../data/profile";
import { about, taglines } from "../data/about";
import { publications } from "../data/publications";

// GitHub, LinkedIn, Hugging Face, then the two Scholars, with Email last.
const email = profile.social.find((s) => s.label === "Email")!;
const links = [...profile.social.filter((s) => s.label !== "Email"), ...scholar, email];
const selected = publications.filter((p) => p.selected);
---

<Base>
  {/* hero */}
  <section class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl">{profile.name}</h1>
      <p class="mt-3 text-lg text-muted">
        <span id="tagline" class="transition-opacity duration-500" data-lines={JSON.stringify(taglines)}>
          {profile.tagline}
        </span>
      </p>
      <p class="mt-2 flex items-center gap-1.5 text-sm text-muted">
        <Icon name="location" />
        {profile.location}
      </p>
      <p class="mt-5 leading-relaxed text-fg/90">{about.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {links.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith("mailto") ? undefined : "_blank"}
            rel="me noopener"
            class="flex items-center gap-2 rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <Icon name={s.icon} />
            {s.label}
          </a>
        ))}
      </div>
    </div>
    {/* photos crossfade; no float animation */}
    <div id="hero-avatar" class="relative h-32 w-32 shrink-0 sm:h-40 sm:w-40">
      <img
        src={profile.avatar}
        alt={profile.name}
        width="160"
        height="160"
        class="avatar-face absolute inset-0 h-full w-full rounded-2xl border border-border object-cover transition-opacity duration-1000 ease-in-out"
        style="opacity:1"
      />
      <img
        src={profile.avatarAlt}
        alt={profile.name}
        width="160"
        height="160"
        class="avatar-face absolute inset-0 h-full w-full rounded-2xl border border-border object-cover transition-opacity duration-1000 ease-in-out"
        style="opacity:0"
      />
    </div>
  </section>

  {/* core experience */}
  <section class="mt-16">
    <h2 class="section-title mb-6 border-b border-border pb-2">🚀 Core Experience</h2>
    <div class="space-y-5">
      {about.coreExperience.map((c) => (
        <div>
          <h3 class="font-display text-[0.95rem] font-semibold uppercase tracking-wide text-accent">{c.label}</h3>
          <p class="mt-1 leading-relaxed text-fg/90">{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  {/* keywords & tech stack */}
  <section class="mt-16">
    <h2 class="section-title mb-6 border-b border-border pb-2">🛠️ Tech Stack & Where I Used It</h2>
    <dl class="space-y-4">
      {about.keywords.map((k) => (
        <div class="sm:flex sm:gap-4">
          <dt class="font-display font-semibold text-fg sm:w-52 sm:shrink-0">{k.group}</dt>
          <dd class="mt-1 text-fg/90 sm:mt-0">{k.items}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* currently exploring */}
  <section class="mt-16">
    <h2 class="section-title mb-6 border-b border-border pb-2">🔭 Currently Exploring</h2>
    <div class="space-y-5">
      {about.exploring.map((c) => (
        <div>
          <h3 class="font-display text-[0.95rem] font-semibold uppercase tracking-wide text-accent">{c.label}</h3>
          <p class="mt-1 leading-relaxed text-fg/90">{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  {/* selected publications */}
  <section class="mt-16">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-border pb-2">
      <h2 class="section-title">📄 Selected Publications</h2>
      <a href="/publications/" class="text-sm text-muted transition-colors hover:text-accent">All publications →</a>
    </div>
    <ul class="divide-y divide-border">
      {selected.map((p) => (
        <li class="py-4">
          <a href={p.url} target="_blank" rel="noopener" class="group block">
            <h3 class="font-display font-semibold leading-snug text-fg transition-colors group-hover:text-accent">{p.title}</h3>
            <p class="mt-1 text-sm text-muted">
              {p.venue && <span class="text-accent">{p.venue} {p.year}</span>}
              {p.venue ? " · " : ""}<span set:html={p.authors.replace(/(Salsabil[^,]*|Akbar)/, "<b class='text-fg'>$1</b>")} />
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* quick links */}
  <section class="mt-16 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {[
      { href: "/repositories/", label: "Repositories", desc: "Open-source & code" },
      { href: "/blog/", label: "Blog", desc: "Write-ups" },
      { href: "/cv/", label: "Resume", desc: "Education & experience" },
      { href: "/activities/", label: "Activities", desc: "Teaching & talks" },
    ].map((c) => (
      <a href={c.href} class="rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent">
        <div class="font-display font-semibold text-fg">{c.label}</div>
        <div class="mt-1 text-sm text-muted">{c.desc}</div>
      </a>
    ))}
  </section>
</Base>

<script>
  import { initAvatar } from "../lib/avatar";

  function initTagline() {
    const el = document.getElementById("tagline");
    if (!el || el.dataset.bound) return;
    el.dataset.bound = "1";

    let lines: string[] = [];
    try {
      lines = JSON.parse(el.dataset.lines || "[]");
    } catch {
      return;
    }
    if (lines.length < 2) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let i = 0;
    setInterval(() => {
      el.style.opacity = "0";
      setTimeout(() => {
        i = (i + 1) % lines.length;
        el.textContent = lines[i];
        el.style.opacity = "1";
      }, 500);
    }, 3500);
  }

  document.addEventListener("astro:page-load", initTagline);
  document.addEventListener("astro:page-load", initAvatar);
</script>

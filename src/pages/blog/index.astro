---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base title="Blog" description="Technical write-ups and notes on things Salsabil Maulana Akbar has built.">
  {posts.length === 0 ? (
    <section class="mx-auto flex min-h-[55vh] max-w-lg flex-col items-center justify-center text-center">
      <div class="text-5xl">🍳</div>
      <p class="eyebrow mb-2 mt-6">Writing</p>
      <h1 class="text-3xl font-bold sm:text-4xl">Something's cooking</h1>
      <p class="mt-3 leading-relaxed text-muted">
        I'm unraveling the magic behind the things I have built and writing it up. New posts are on the way, so check
        back soon.
      </p>
      <a
        href="/about/"
        class="mt-8 rounded-full border border-border px-5 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
      >
        ← Back to about
      </a>
    </section>
  ) : (
    <>
      <header class="mb-8">
        <p class="eyebrow mb-2">Writing</p>
        <h1 class="text-3xl font-bold sm:text-4xl">Blog</h1>
        <p class="mt-3 text-muted">Write-ups on things I have built. Filter by topic, or ask the assistant.</p>
      </header>

      {allTags.length > 0 && (
        <div id="tag-bar" class="mb-8 flex flex-wrap gap-2">
          <button data-tag="" class="tag-btn flex min-h-9 items-center rounded-full border border-accent bg-accent px-3.5 text-xs font-medium text-accent-fg">All</button>
          {allTags.map((t) => (
            <button data-tag={t} class="tag-btn flex min-h-9 items-center rounded-full border border-border px-3.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">
              {t}
            </button>
          ))}
        </div>
      )}

      <ul id="post-list" class="divide-y divide-border">
        {posts.map((p) => (
          <li class="post-item py-6" data-tags={p.data.tags.join(",")}>
            <a href={`/blog/${p.id}/`} class="group block">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
                <h2 class="font-display text-lg font-semibold text-fg transition-colors group-hover:text-accent">{p.data.title}</h2>
                <span class="shrink-0 font-mono text-xs text-muted">{fmt(p.data.date)}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.data.summary}</p>
              {p.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {p.data.tags.map((t) => (
                    <span class="rounded-full bg-surface px-2.5 py-0.5 text-[11px] text-muted">{t}</span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>

      <p id="post-empty" class="hidden py-10 text-center text-sm text-muted">No posts with that tag yet.</p>
    </>
  )}
</Base>

<script>
  function initBlog() {
    const bar = document.getElementById("tag-bar");
    if (!bar || bar.dataset.bound) return; // idempotent; absent on the coming-soon state
    bar.dataset.bound = "1";

    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>(".tag-btn"));
    const items = Array.from(document.querySelectorAll<HTMLElement>(".post-item"));
    const empty = document.getElementById("post-empty")!;

    const active = "border-accent bg-accent text-accent-fg font-medium";
    const idle = "border-border text-muted";

    function setActive(tag: string) {
      buttons.forEach((b) => {
        const on = b.dataset.tag === tag;
        b.className =
          "tag-btn flex min-h-9 items-center rounded-full border px-3.5 text-xs transition-colors " +
          (on ? active : idle + " hover:border-accent hover:text-accent");
      });
      let shown = 0;
      items.forEach((li) => {
        const tags = (li.dataset.tags || "").split(",");
        const show = !tag || tags.includes(tag);
        li.classList.toggle("hidden", !show);
        if (show) shown++;
      });
      empty.classList.toggle("hidden", shown > 0);
    }

    buttons.forEach((b) => b.addEventListener("click", () => setActive(b.dataset.tag || "")));

    const wanted = new URLSearchParams(location.search).get("tag");
    setActive(wanted && buttons.some((b) => b.dataset.tag === wanted) ? wanted : "");
  }

  document.addEventListener("astro:page-load", initBlog);
</script>

---
import Base from "../layouts/Base.astro";

const teaching = [
  {
    where: "Tokopedia",
    what: "Mentor & Instructor",
    when: "Aug 2022 - Nov 2022",
    detail:
      "Prepared and delivered an introduction to Natural Language Processing for the Tokopedia engineering team, as part of the Data Science and Engineering team's internal learning program.",
  },
  {
    where: "Institut Teknologi Kalimantan",
    what: "Speaker",
    when: "Aug 2022 - Nov 2022",
    detail: "Gave a talk on career prospects in the data field from a mathematics perspective.",
  },
  {
    where: "Bitlabs Data Analytics for Business",
    what: "Instructor",
    when: "Aug 2022 - Nov 2022",
    detail: "Taught elementary to intermediate SQL and Python to fresh graduates.",
  },
  {
    where: "Bangkit Academy",
    what: "Instructor & Mentor, Machine Learning path",
    when: "Jan 2022 - May 2022",
    detail:
      "Taught Mathematics for Machine Learning and mentored cohorts on computer vision and NLP applications for their capstone projects.",
  },
  {
    where: "Various private institutions (self-employed)",
    what: "Tutor",
    when: "Aug 2018 - May 2021",
    detail:
      "Tutored first and second year students across Business Mathematics, Calculus, Linear Algebra, and Statistics.",
  },
  {
    where: "Statistics Department, Universitas Padjadjaran",
    what: "Workshop instructor",
    when: "Aug 2018 - Dec 2019",
    detail: "Delivered a workshop on Statistics and Data Analysis with R.",
  },
  {
    where: "Mathematics, ITB",
    what: "Laboratory assistant & tutor",
    when: "Aug 2018 - Dec 2019",
    detail:
      "Assisted with solving math problems using software. Courses: Statistical Data Analysis, Data Visualization & Preprocessing, Mathematical Simulation & Computation, and Numerical Mathematics.",
  },
  {
    where: "Electrical Engineering & Informatics, ITB",
    what: "Teaching assistant",
    when: "Feb 2018 - May 2018",
    detail:
      "Teaching assistant for the Introduction to Engineering & Design course, across both the School of Electrical Engineering & Informatics and the Faculty of Mathematics & Natural Sciences.",
  },
  {
    where: "SUSBM Education",
    what: "Online mentor",
    when: "Aug 2016 - May 2017",
    detail: "Tutored Mathematics and Physics for the Indonesian university entrance test (SBMPTN).",
  },
];
---

<Base title="Activities" description="Teaching, mentoring, and community involvement of Salsabil Maulana Akbar.">
  <header class="mb-10">
    <p class="eyebrow mb-2">Beyond work</p>
    <h1 class="text-3xl font-bold sm:text-4xl">Activities</h1>
    <p class="mt-3 text-muted">
      Teaching, mentoring, and tutoring alongside my main roles, from math fundamentals to Natural Language Processing.
    </p>
  </header>

  <section>
    <h2 class="eyebrow mb-6">Teaching & mentoring</h2>
    <div class="space-y-8">
      {teaching.map((r) => (
        <div class="border-l border-border pl-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="font-display text-lg font-semibold">{r.what}</h3>
            <span class="font-mono text-xs text-muted">{r.when}</span>
          </div>
          <p class="text-sm text-accent">{r.where}</p>
          <p class="mt-3 leading-relaxed text-fg/90">{r.detail}</p>
        </div>
      ))}
    </div>
  </section>

  {/* room to grow: add <section> blocks here for Talks, Community, or Awards */}
</Base>

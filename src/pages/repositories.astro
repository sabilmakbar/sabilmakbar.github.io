---
import Base from "../layouts/Base.astro";
import RepoCard from "../components/RepoCard.astro";

// Two independent groups, resolved at BUILD time:
//   FEATURED: cross-org research contributions, always shown (hand-picked,
//             since the API can't discover repos outside your account)
//   personal: your own repos, auto-ranked by stars + recency
const OWNER = "sabilmakbar";
const FEATURED = [
  "SEACrowd/seacrowd-datahub",
  "indonlp/nusa-writes",
  "indonlp/cendol",
  "SEACrowd/seacrowd-experiments",
];
// profile-config repo, this site's own repo, and the memory template, not "projects" to feature
const EXCLUDE_OWN = new Set(["sabilmakbar", "sabilmakbar.github.io", "claude-memories-template"]);
const PERSONAL_LIMIT = 6;

// read at build time (GitHub Actions provides GITHUB_TOKEN in the environment)
const token = process.env.GITHUB_TOKEN;
const headers: Record<string, string> = { "User-Agent": "astro-build", Accept: "application/vnd.github+json" };
if (token) headers.Authorization = `Bearer ${token}`;

async function gh(url: string) {
  const r = await fetch(url, { headers });
  if (!r.ok) throw new Error(`${r.status} ${url}`);
  return r.json();
}
const shape = (r: any) => ({
  name: r.name,
  owner: r.full_name.split("/")[0],
  desc: r.description || "",
  stars: r.stargazers_count ?? 0,
  lang: r.language || "",
  url: r.html_url,
});

let featured: ReturnType<typeof shape>[] = [];
let personal: ReturnType<typeof shape>[] = [];
try {
  featured = (await Promise.all(FEATURED.map((p) => gh(`https://api.github.com/repos/${p}`)))).map(shape);
  const own = (await gh(`https://api.github.com/users/${OWNER}/repos?per_page=100&sort=updated`)).filter(
    (r: any) => !r.fork && !r.archived && !EXCLUDE_OWN.has(r.name),
  );
  const yearAgo = Date.now() - 365 * 24 * 3600 * 1000;
  const score = (r: any) =>
    (r.stargazers_count || 0) * 3 + (Date.parse(r.pushed_at) > yearAgo ? 2 : 0) + (r.description ? 1 : 0);
  own.sort((a: any, b: any) => score(b) - score(a));
  personal = own.slice(0, PERSONAL_LIMIT).map(shape);
} catch (e) {
  // If the GitHub API is unreachable at build time, degrade to featured
  // link-cards only (built from the FEATURED list); skip the personal grid
  // rather than ship a stale hand-maintained list.
  console.warn("[repositories] GitHub fetch failed, showing featured links only:", (e as Error).message);
  const stat = (repo: string) => ({
    name: repo.split("/")[1], owner: repo.split("/")[0], desc: "", stars: -1, lang: "", url: `https://github.com/${repo}`,
  });
  featured = FEATURED.map(stat);
  personal = [];
}
---

<Base title="Repositories" description="Open-source contributions and projects by Salsabil Maulana Akbar.">
  <header class="mb-10">
    <p class="eyebrow mb-2">Code</p>
    <h1 class="text-3xl font-bold sm:text-4xl">Repositories</h1>
    <p class="mt-3 text-muted">
      Research contributions and personal projects, refreshed from GitHub. More on{" "}
      <a href="https://github.com/sabilmakbar" target="_blank" rel="noopener" class="text-accent hover:underline">GitHub</a>.
    </p>
  </header>

  {featured.length > 0 && (
    <section class="mb-14">
      <h2 class="eyebrow mb-4">Featured contributions</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {featured.map((r) => <RepoCard repo={r} />)}
      </ul>
    </section>
  )}

  <section>
    <h2 class="eyebrow mb-4">Personal projects</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {personal.map((r) => <RepoCard repo={r} />)}
    </ul>

    <div class="mt-8 flex justify-center">
      <a
        href={`https://github.com/${OWNER}`}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-6 text-sm font-medium text-muted transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        Explore more on GitHub
      </a>
    </div>
  </section>
</Base>

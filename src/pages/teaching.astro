---
import Base from "../layouts/Base.astro";

const roles = [
  {
    where: "Bandung Institute of Technology (ITB)",
    what: "Teaching & grading assistant",
    detail:
      "Assisted students during my second and third undergraduate years. Started as a Data Analysis lab assistant for non-Math students, then took on Numerical & Computational Mathematics and Intermediate Data Analysis for Math students. Also served as a grading assistant for Calculus and first-year Mathematics for non-STEM majors.",
  },
  {
    where: "Private tutoring",
    what: "Independent tutor",
    detail:
      "Tutored students in Calculus, Basic Statistics, and Matrices & Vectors (an elementary, computation-focused take on Linear Algebra).",
  },
];
---

<Base title="Teaching" description="Teaching and assistantship experience of Salsabil Maulana Akbar.">
  <header class="mb-10">
    <p class="eyebrow mb-2">Assistantship</p>
    <h1 class="text-3xl font-bold sm:text-4xl">Teaching</h1>
    <p class="mt-3 text-muted">Assistant and tutoring roles during and after my degree at ITB.</p>
  </header>

  <div class="space-y-8">
    {roles.map((r) => (
      <section class="border-l border-border pl-5">
        <h2 class="font-display text-lg font-semibold">{r.what}</h2>
        <p class="text-sm text-accent">{r.where}</p>
        <p class="mt-3 leading-relaxed text-fg/90">{r.detail}</p>
      </section>
    ))}
  </div>
</Base>
